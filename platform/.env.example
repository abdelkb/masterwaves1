# ---- Turso (base de données SQLite cloud) ----
# Créer une base : https://turso.tech  →  turso db create masterwaves
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Pour développement local sans Turso, utiliser un fichier local :
# TURSO_DATABASE_URL=file:./db/local.db

# ---- Authentification ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- Pusher (temps réel : tracking GPS + notifications) ----
# https://pusher.com  → créer une app
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ---- Google Maps ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Cloudinary (images produits/logos) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
